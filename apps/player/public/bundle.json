        "id": "dodge",
        "displayName": "Dodge",
        "description": "When attacked on the opponent's turn, flip a coin (heads: take 0 damage; tails: take full damage). Usable once per opponent turn.",
        "cost": 3
      },
      {
        "id": "matchup-master",
        "displayName": "Matchup Master",
        "description": "When this fighter attacks with class advantage, add +10 more damage (total +20 with the class bonus).",
        "cost": 2
      },
      {
        "id": "regain-health",
        "displayName": "Regain Health",
        "description": "Once per turn, before you attack, you may heal 10 HP — if you do, this fighter can't attack this turn.",
        "cost": 2
      },
      {
        "id": "run-away",
        "displayName": "Run Away",
        "description": "Once per turn, before you attack, switch this fighter with one from your Minivan without using your Action. No effect if your Minivan is empty.",
        "cost": 1
      }
    ],
    "supportEffects": [
      {
        "id": "pep-talk",
        "displayName": "Pep Talk",
        "description": "Restore 50% of your Active Character's max HP (rounded down).",
        "maxPerDeck": 2
      },
      {
        "id": "find-a-friend",
        "displayName": "Find a Friend",
        "description": "Search your deck for any 1 Character, add it to your hand, then shuffle.",
